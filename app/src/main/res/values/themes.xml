<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar" />

    <!-- MediaRouter reads contrast colors while constructing MediaRouteButton.
         Keep every relevant surface/control color explicitly opaque. -->
    <style name="Theme.NSiO.CastButton" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorBackground">#FF202124</item>
        <item name="android:windowBackground">#FF202124</item>
        <item name="android:colorForeground">#FFFFFFFF</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
        <item name="android:colorControlNormal">#FFFFFFFF</item>
        <item name="android:colorControlActivated">#FFFFFFFF</item>
        <item name="colorPrimary">#FF202124</item>
        <item name="colorPrimaryDark">#FF000000</item>
        <item name="colorAccent">#FFFFFFFF</item>
    </style>

</resources>
